# ============================================================
# .env.example — Template for all required environment variables
#
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in the real values in .env
#   3. NEVER commit .env to git — it contains secrets
#      Add ".env" to your .gitignore file.
# ============================================================

# ------------------------------------------------------------
# REQUIRED — the server will refuse to start without these
# ------------------------------------------------------------

# Groq API key — get a free key from https://console.groq.com
GROQ_API_KEY=

# A secret token that the Spring Boot service sends in every request header.
# Format: Authorization: Bearer <this value>
# Generate a strong random value, e.g.: openssl rand -hex 32
API_BEARER_TOKEN=

# ------------------------------------------------------------
# OPTIONAL — sensible defaults are provided if not set
# ------------------------------------------------------------

# Path on disk where ChromaDB stores its data between restarts.
CHROMA_PERSIST_PATH=./chroma_data

# Sentence-transformer model used to create embedding vectors.
# all-MiniLM-L6-v2 is fast and small (~80 MB). Downloaded on first run.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Groq model to use. gpt-oss-20b replaces deprecated llama-3.1-8b-instant (decommissioned Aug 16 2026).
# Other options: llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=gpt-oss-20b

# Maximum tokens the LLM can generate in a single response (~750 words at 1024).
LLM_MAX_TOKENS=1024

# Response creativity: 0.0 = deterministic, 1.0 = very creative.
LLM_TEMPERATURE=0.7

# Port that uvicorn listens on.
PORT=8000

# Path on disk where per-user graph JSON files are stored.
GRAPH_PERSIST_PATH=./graph_data

# ------------------------------------------------------------
# PostgreSQL — graph memory storage (same database as Spring Boot)
# ------------------------------------------------------------

# PostgreSQL host. Use "localhost" for local dev, or your RDS/Cloud SQL host.
DB_HOST=localhost

# PostgreSQL port. Default is 5432.
DB_PORT=5432

# Database name. Must match Spring Boot's datasource URL.
DB_NAME=cognitive_memory

# PostgreSQL user.
DB_USER=postgres

# PostgreSQL password. *** FILL IN BEFORE STARTING THE SERVER ***
DB_PASSWORD=
